{
  "_comment": [
    "Where each dispatched op's kernel lives, so the ranker can emit a ready-to-use",
    "handoff for the xpu-kernel-optimizer skill.",
    "Lookup order: an 'ops' entry for the exact dispatch name first, then 'backends'",
    "keyed by the trace's backend classification.",
    "Paths are relative to the workspace root (the parent of this repo)."
  ],
  "backends": {
    "vllm-xpu-kernels": {
      "repo": "vllm-xpu-kernels",
      "kernel_dir": "vllm-xpu-kernels/csrc",
      "files": [
        "csrc/**/*.cpp",
        "csrc/**/*.h"
      ],
      "language": "sycl",
      "build_cmd": "cd vllm-xpu-kernels && MAX_JOBS=16 pip install --no-build-isolation -v -e . --no-deps",
      "test_cmd": "cd vllm-xpu-kernels && pytest tests -v",
      "notes": "Add -DFA2_KERNELS_ENABLED=False when not touching attention (large build-time saver)."
    },
    "flash_xpu": {
      "repo": "applications.ai.gpu.deepklox",
      "kernel_dir": "applications.ai.gpu.deepklox/csrc",
      "files": [
        "csrc/**/*.cpp",
        "csrc/**/*.h"
      ],
      "language": "sycl",
      "build_cmd": "cd applications.ai.gpu.deepklox && GPU_ARCHS=native uv pip install --no-build-isolation -e . -v",
      "test_cmd": "cd applications.ai.gpu.deepklox && python -m pytest tests -v",
      "notes": "Build MSA-only (XATTENTION_ENABLED_KERNELS=msa); =all can device-lost the box."
    },
    "triton": {
      "repo": "vllm-xpu",
      "kernel_dir": "vllm-xpu/vllm",
      "files": [
        "**/*triton*.py"
      ],
      "language": "triton",
      "build_cmd": "cd vllm-xpu && VLLM_USE_PRECOMPILED=1 uv pip install -e . --torch-backend=auto",
      "test_cmd": null
    },
    "torch-xpu-ops": {
      "repo": "torch-xpu-ops",
      "kernel_dir": "torch-xpu-ops",
      "files": [
        "src/**/*.cpp"
      ],
      "language": "aten",
      "build_cmd": null,
      "test_cmd": null,
      "notes": "ATen fallback - usually the fix is to dispatch elsewhere, not to edit ATen."
    },
    "ccl": {
      "repo": "-",
      "kernel_dir": "-",
      "files": [],
      "language": "ccl",
      "build_cmd": null,
      "test_cmd": null,
      "notes": "oneCCL collective - tune env/topology, not kernel source."
    },
    "flashinfer": {
      "repo": "flashinfer",
      "kernel_dir": "flashinfer",
      "files": [
        "csrc/**/*.cu",
        "flashinfer/**/*.py"
      ],
      "language": "cuda",
      "notes": "FlashInfer kernels are launched straight from Python; the editable surface is the JIT/AOT csrc."
    },
    "vllm-cuda-kernels": {
      "repo": "vllm",
      "kernel_dir": "vllm/csrc",
      "files": [
        "csrc/**/*.cu",
        "csrc/**/*.cuh"
      ],
      "language": "cuda",
      "build_cmd": "cd vllm && pip install --no-build-isolation -v -e .",
      "test_cmd": "cd vllm && pytest tests/kernels -v"
    }
  },
  "ops": {
    "_C::silu_and_mul_with_clamp": {
      "files": [
