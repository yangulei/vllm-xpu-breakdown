{
  "_comment": [
    "Where each micro_perf provider's kernel lives, so rank_targets.py can emit a",
    "ready-to-use handoff for the xpu-kernel-optimizer skill.",
    "Lookup order: 'ops' entry matching '<provider>:<op>' first, then 'providers'.",
    "Paths are relative to the workspace root (/root/vllm_xpu)."
  ],
  "providers": {
    "flash_xpu": {
      "repo": "applications.ai.gpu.deepklox",
      "kernel_dir": "applications.ai.gpu.deepklox/csrc",
      "files": ["csrc/**/*.cpp", "csrc/**/*.h"],
      "language": "sycl",
      "build_cmd": "cd applications.ai.gpu.deepklox && GPU_ARCHS=native uv pip install --no-build-isolation -e . -v",
      "test_cmd": "cd applications.ai.gpu.deepklox && python -m pytest tests -v",
      "notes": "Build MSA-only (XATTENTION_ENABLED_KERNELS=msa); =all can device-lost the box."
    },
    "vllm_xpu_kernels": {
      "repo": "vllm-xpu-kernels",
      "kernel_dir": "vllm-xpu-kernels/csrc",
      "files": ["csrc/**/*.cpp", "csrc/**/*.h"],
      "language": "sycl",
      "build_cmd": "cd vllm-xpu-kernels && MAX_JOBS=16 pip install --no-build-isolation -v -e . --no-deps",
      "test_cmd": "cd vllm-xpu-kernels && pytest tests -v",
      "notes": "Add -DFA2_KERNELS_ENABLED=False when not touching attention (large build-time saver)."
    },
    "sycl_tla": {
      "repo": "sycl-tla",
      "kernel_dir": "sycl-tla",
      "files": ["include/**/*.hpp", "examples/**/*.cpp"],
      "language": "sycl-tla",
      "build_cmd": "see sycl-tla/README.md",
      "test_cmd": null
    },
    "triton": {
      "repo": "vllm-xpu",
      "kernel_dir": "vllm-xpu/vllm",
      "files": ["**/*triton*.py"],
      "language": "triton",
      "build_cmd": "cd vllm-xpu && VLLM_USE_PRECOMPILED=1 uv pip install -e . --torch-backend=auto",
      "test_cmd": null
    },
    "sycl_ext": {
      "repo": "xpu-perf",
      "kernel_dir": "xpu-perf/projects/micro_perf/vendor_ops/INTEL/ops/sycl_ext",
      "files": ["*.py", "*.cpp"],
      "language": "sycl",
      "build_cmd": null,
      "test_cmd": null
    },
    "onednn": {
      "repo": "torch-xpu-ops",
      "kernel_dir": "torch-xpu-ops",
      "files": ["src/**/*.cpp"],
      "language": "onednn",
      "build_cmd": null,
      "test_cmd": null,
      "notes": "Library kernel - prefer tuning the call (layout/primitive cache) over editing oneDNN."
    },
    "torch": {
      "repo": "torch-xpu-ops",
      "kernel_dir": "torch-xpu-ops",
      "files": ["src/**/*.cpp"],
      "language": "aten",
      "build_cmd": null,
      "test_cmd": null,
      "notes": "ATen fallback - usually the fix is to dispatch elsewhere, not to edit ATen."
    },
    "xccl": {
      "repo": "-",
      "kernel_dir": "-",
      "files": [],
      "language": "ccl",
      "build_cmd": null,
      "test_cmd": null,
      "notes": "oneCCL collective - tune env/topology, not kernel source."
    }
  },
  "ops": {
    "flash_xpu:msa_sparse_attn": {
      "files": ["csrc/msa/msa_sparse_attn.cpp", "csrc/msa/msa.h"],
      "test_cmd": "cd applications.ai.gpu.deepklox && python -m pytest tests/test_msa.py -v"
    },
    "flash_xpu:msa_index_score": {
      "files": ["csrc/msa/msa_index_score.cpp", "csrc/msa/msa.h"],
      "test_cmd": "cd applications.ai.gpu.deepklox && python -m pytest tests/test_msa.py -v"
    },
    "flash_xpu:msa_index_topk": {
      "files": ["csrc/msa/msa_topk.cpp", "csrc/msa/msa.h"],
      "test_cmd": "cd applications.ai.gpu.deepklox && python -m pytest tests/test_msa.py -v"
    },
    "flash_xpu:msa_index_decode": {
      "files": ["csrc/msa/msa_index_decode.cpp", "csrc/msa/msa.h"],
      "test_cmd": "cd applications.ai.gpu.deepklox && python -m pytest tests/test_msa.py -v"
    },
    "flash_xpu:flash_attention": {
      "files": ["csrc/mha/**", "csrc/flash_api.cpp"],
      "test_cmd": "cd applications.ai.gpu.deepklox && python -m pytest tests -k attention -v"
    },
    "vllm_xpu_kernels:cutlass_grouped_gemm": {
      "files": ["csrc/xpu/**", "csrc/moe/**"],
      "test_cmd": "cd vllm-xpu-kernels && pytest tests/test_moe.py -v"
    },
    "vllm_xpu_kernels:rms_norm": {
      "files": ["csrc/layernorm.cpp"],
      "test_cmd": "cd vllm-xpu-kernels && pytest tests/test_layernorm.py -v"
    },
    "vllm_xpu_kernels:add_rms_norm": {
      "files": ["csrc/layernorm.cpp"],
      "test_cmd": "cd vllm-xpu-kernels && pytest tests/test_layernorm.py -v"
    },
    "vllm_xpu_kernels:silu_and_mul_with_clamp": {
      "files": ["csrc/activation.cpp"],
      "test_cmd": "cd vllm-xpu-kernels && pytest tests/test_activation.py -v"
    },
    "vllm_xpu_kernels:swigluoai_and_mul": {
      "files": ["csrc/activation.cpp"],
      "test_cmd": "cd vllm-xpu-kernels && pytest tests/test_activation.py -v"
    },
    "vllm_xpu_kernels:topk_sigmoid": {
      "files": ["csrc/topk_per_row.cpp"],
      "test_cmd": "cd vllm-xpu-kernels && pytest tests/test_topk.py -v"
    },
    "vllm_xpu_kernels:fused_qknorm_rope_kv": {
      "files": ["csrc/fused_minimax_m3_qknorm_rope_kv_insert.cpp", "csrc/fused_qknorm_rope.cpp"],
      "test_cmd": "cd vllm-xpu-kernels && pytest tests/test_fused_qknorm_rope.py -v"
    },
    "vllm_xpu_kernels:store_kv_cache": {
      "files": ["csrc/cache.cpp"],
      "test_cmd": "cd vllm-xpu-kernels && pytest tests/test_cache.py -v"
    },
    "vllm_xpu_kernels:flash_attention": {
      "files": ["csrc/flash_attn/**", "csrc/attention/**"],
      "test_cmd": "cd vllm-xpu-kernels && pytest tests/test_flash_attn.py -v"
    }
  }
}
